{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "ModbusRTUStoreForwardBridge",
  "version": "0.3.0",
  "description": "Allocation-free C++11 planning and cooperative orchestration for cached Modbus RTU bridges",
  "keywords": [
    "modbus",
    "rtu",
    "bridge",
    "embedded"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cybergrany/ModbusRTUStoreForwardBridge.git"
  },
  "authors": [
    {
      "name": "Cybergrany contributors",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "modbus_rtu_bridge/RouteTable.h",
    "modbus_rtu_bridge/CacheImage.h",
    "modbus_rtu_bridge/DownstreamExecutor.h",
    "modbus_rtu_bridge/IngressWork.h",
    "modbus_rtu_bridge/ForwardPlan.h",
    "modbus_rtu_bridge/CompletionTransition.h",
    "modbus_rtu_bridge/FixedStorage.h",
    "modbus_rtu_bridge/CompletionLedger.h",
    "modbus_rtu_bridge/PollPlanner.h",
    "modbus_rtu_bridge/StoreForwardBridge.h",
    "modbus_rtu_bridge/adapters/ModbusRTUMasterBackend.h"
  ],
  "export": {
    "exclude": [
      ".git",
      ".github",
      ".pio",
      "scripts",
      "test"
    ]
  },
  "build": {
    "includeDir": "include"
  }
}
